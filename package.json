{
  "name": "tolu-portfolio-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "server": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:all": "npm --prefix frontend run build && npm --prefix backend run build",
    "vercel-build": "npm run build:all",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
